# 推荐直接跑向导自动生成：python setup.py（Windows 双击 start.bat）
# 也可手动复制为 .env 并填写
TAM_API_ID=              # my.telegram.org 申请；仅 tdata 导入可留空
TAM_API_HASH=
TAM_MASTER_KEY=          # 向导自动生成，或 python -m tam.cli init-key
TAM_WEB_TOKEN=           # Web/API 访问令牌，向导自动生成
TAM_NO_AUTH=0           # 1 = 本机免令牌（打开网页即用，仅限 127.0.0.1）
TAM_DATA_DIR=./data
TAM_DEFAULT_PROXY=       # socks5://user:pass@host:1080
TAM_RATE=0.5             # 每账号每秒最大请求数
TAM_MIN_DELAY=8          # 批量动作最小随机间隔（秒）
TAM_MAX_DELAY=25         # 批量动作最大随机间隔（秒）
TAM_AUTO_KICK_HOURS=24   # 默认清设备周期（小时，0=全局关闭）
TAM_AUTO_KICK_LOOP=1     # 默认是否循环踢（1=是，账号可单独关）
TAM_KICK_RETRY=1h        # 清设备失败/校验未通过后隔多久重试：45s / 10m / 2h / 1h30m（最小 10s）

# --- 并发（网页参数面板里也能改，改完写回这个文件）---
TAM_WORKERS=4            # ZIP 处理（拆包/合并/注册时间）的并发度，上限 32
TAM_BATCH_CONCURRENCY=3  # 批量跑号（工具箱、批量任务）默认并行数；调大容易触频控
TAM_REGEN_CONCURRENCY=1  # 批量重生默认并行数（1-8）
TAM_UI_OP_TIMEOUT=120    # 单个账号操作超时秒数，超时自动跳过

# --- ZIP 工具 ---
TAM_MAX_EXTRACT_MB=512   # 解压后总大小上限，防 zip 炸弹
TAM_REGTIME_ENDPOINT=    # 留空 = 完全离线，只用包里 json 已有的日期，一个字节不外发
TAM_REGTIME_UUID=        # 上面那个接口要的身份标识（如果它要）
TAM_REGTIME_VERIFY_SSL=1 # 实在要关才改 0；原版写死了不验证，这里默认验证
TAM_REGTIME_TIMEOUT=10   # 秒

# --- 启动交互 ---
TAM_NO_MENU=0            # 1 = 不弹 start 选单，直接按配置起（服务器/systemd 里用）

# --- 部署形态与前端选择（python -m tam.cli run 读这两个）---
TAM_DEPLOY=local         # local = 本机自用（只绑 127.0.0.1）；server = 服务器（绑 0.0.0.0，建议配代理+HTTPS）
TAM_FRONTEND=web         # web = 只网页；bot = 只 Telegram 机器人；both = 两个一起跑
TAM_HOST=                # 留空则由 TAM_DEPLOY 决定
TAM_PORT=8848
TAM_PROXY_FILE=proxy.txt # 机器人侧代理池，每行：IP:端口:账户:密码:过期时间戳

# --- Telegram 机器人前端（TAM_FRONTEND=bot 或 both 时必填）---
TAM_BOT_TOKEN=           # @BotFather 领取
TAM_BOT_ADMIN_ID=        # 你自己的数字 ID，/vip /unvip /gb 只对它生效
START_JOIN_USERNAME=     # 强制入群频道用户名，留空=不强制
START_MESSAGE=你好 {USER}，请从下方选一个功能。
START_MESSAGE_UN=账号未激活，请先完成支付或联系管理员。
START_JOIN_MESSAGE=请先加入频道后再使用。
MERGE_PACKS_BACK=请上传要整合的号包 ZIP。
REGTIME_BACK=请上传号包 ZIP，返回注册时间。
ADS_1=                   # 底部广告位，格式：文字-链接
ADS_2=
ADS_3=

# --- 付费/VIP（留空 OKPAY_COST = 不收费，进来就是 VIP，适合自用）---
OKPAY_ID=
OKPAY_TOKEN=
OKPAY_COST=              # 单次金额，如 5
OKPAY_PAYED=USDT         # 币种
OKPAY_RETURN_URL=

# --- AI / Agent 控制层 ---
TAM_READONLY_TOKEN=      # 只读令牌：持此令牌只能调用 read 类工具
TAM_READONLY=0           # 1 = 全局只读
TAM_DRY_RUN=0            # 1 = 干跑，写操作只返回预览
TAM_PEER_ALLOWLIST=      # 逗号分隔的发送对象白名单，如 @me,@myalt

# 转 API 取码链接前缀（网页 ZIP 工具 / 兼容机器人）
# TAM_TOAPI_BASE=https://your-getcode-host
